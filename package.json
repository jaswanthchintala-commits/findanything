{
  "name": "findanything",
  "productName": "FindAnything",
  "version": "1.1.0",
  "description": "FindAnything - Super Google Desktop. Instant deep-content local file search engine for Windows and macOS.",
  "main": "src/main/main.js",
  "author": {
    "name": "FindAnything Team"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps",
    "test:config": "node test/scripts/test-config.js",
    "test:db": "node test/scripts/test-db.js",
    "test:extract": "node test/scripts/test-extract.js",
    "test:engine": "node test/scripts/test-engine.js",
    "test:throttle": "node test/scripts/test-throttle-active.js",
    "test:e2e": "xvfb-run -a node test/scripts/test-e2e.js",
    "test:all": "npm run test:config && npm run test:db && npm run test:extract && npm run test:engine && npm run test:throttle",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "node build/stage-prebuilds.js win32 x64 && electron-builder --win",
    "dist:mac": "node build/stage-prebuilds.js darwin x64 && electron-builder --mac --x64 && node build/stage-prebuilds.js darwin arm64 && electron-builder --mac --arm64",
    "dist:all": "npm run dist:win && npm run dist:mac"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "pdf-lib": "^1.17.1",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "build": {
    "appId": "com.findanything.app",
    "productName": "FindAnything",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FindAnything"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "FindAnything",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
